#version 450
// main 程序本体内嵌的 4 个查询计算核的 GLSL 版，供 Vulkan 后端用；照 dm/gfx/nvn/nvn_builtin.h 的 MSL 版写，不是 Maxwell 自动翻译。
// MIT-licensed Android compatibility implementation.
// MODE 0=q_val0，1=q_val8，2=q_dlt0，3=q_dlt8；dm/gfx/tools/pack_builtin_queries.py 按 MODE 编出 4 个 .xgs。
// 地址偏移都保留原来的 32 位回绕；用一对 uint，不用 Int64。
// GLSL versions of the 4 query compute kernels embedded in the main program, for the Vulkan backend; written after the
// MSL versions in dm/gfx/nvn/nvn_builtin.h, not an automatic Maxwell translation.
// MIT-licensed Android compatibility implementation.
// MODE 0=q_val0, 1=q_val8, 2=q_dlt0, 3=q_dlt8; dm/gfx/tools/pack_builtin_queries.py compiles the 4 .xgs by MODE.
// All address offsets retain the original 32-bit wrap. uint pairs avoid Int64.
layout(local_size_x = 32, local_size_y = 1, local_size_z = 1) in;
layout(std140, set = 0, binding = 0) uniform Count { uint n; } count;
layout(std430, set = 0, binding = 1) readonly buffer InputWords { uint words[]; } src;
layout(std430, set = 0, binding = 2) writeonly buffer OutputWords { uint words[]; } dst;

uvec2 load64(uint byteOffset) {
    uint i = byteOffset >> 2;
    return uvec2(src.words[i], src.words[i + 1u]);
}

uvec2 sub64(uvec2 after, uvec2 before) {
    return uvec2(after.x - before.x, after.y - before.y - uint(after.x < before.x));
}

void main() {
    uint id = (gl_WorkGroupID.x << 5) + gl_LocalInvocationID.x;
    if (id >= count.n) return;
#if MODE == 0
    uvec2 value = load64(id << 4);
#elif MODE == 1
    uvec2 value = load64((id << 4) + 8u);
#elif MODE == 2
    uint base = id << 5;
    uvec2 value = sub64(load64(base + 16u), load64(base));
#elif MODE == 3
    uint base = (id << 5) + 16u;
    uvec2 value = sub64(load64(base + 8u), load64(base - 8u));
#else
#error MODE must be one of 0, 1, 2, 3
#endif
    uint outWord = (id << 3) >> 2;
    dst.words[outWord] = value.x;
    dst.words[outWord + 1u] = value.y;
}
